          "stringUnit" : {
            "state" : "translated",
            "value" : "ປິດສຽງເພື່ອຫຼິ້ນແບບງຽບໆ. ເກມຍັງຫຼິ້ນໄດ້ຄືເກົ່າ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Išjunk garsą ir žaisk tyliai. Žaidimas veiks lygiai taip pat."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izslēdz skaņu, lai spēlētu klusi. Spēle darbojas tieši tāpat."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исклучи го звукот за тивка игра. Играта останува иста."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ശാന്തമായി കളിക്കാൻ ശബ്ദം ഓഫ് ചെയ്യൂ. കളി അതേപോലെ തന്നെ പ്രവർത്തിക്കും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дууг унтраавал чимээгүй тоглоно. Тоглоом хэвээрээ ажиллана."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शांतपणे खेळण्यासाठी आवाज बंद कर. खेळ तसाच चालेल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matikan bunyi untuk bermain senyap. Permainan tetap sama."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "တိတ်တိတ်ကစားချင်ရင် အသံပိတ်ပါ။ ကစားပုံက အတူတူပါပဲ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå av lyden for å spille stille. Spillet fungerer akkurat likt."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शान्त खेल्न ध्वनि बन्द गर। खेल उस्तै चल्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet het geluid uit om stil te spelen. Het spel werkt precies hetzelfde."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଚୁପଚାପ ଖେଳିବାକୁ ଶବ୍ଦ ବନ୍ଦ କର। ଖେଳ ସେହିଭଳି ଚାଲିବ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਚੁੱਪਚਾਪ ਖੇਡਣ ਲਈ ਆਵਾਜ਼ ਬੰਦ ਕਰੋ। ਖੇਡ ਓਹੀ ਰਹੇਗੀ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłącz dźwięk, by grać po cichu. Gra działa tak samo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliga o som para jogar em silêncio. O jogo funciona exatamente da mesma forma."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oprește sunetul ca să joci în liniște. Jocul rămâne la fel."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключи звук, чтобы играть тихо. Игра останется такой же."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "නිහඬව සෙල්ලම් කරන්න ශබ්දය අක්‍රිය කරන්න. ක්‍රීඩාව ඒ විදිහටම වැඩ කරයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypni zvuk a hraj potichu. Hra funguje úplne rovnako."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izklopi zvok za tiho igranje. Igra ostane povsem enaka."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fike tingullin për të luajtur në qetësi. Loja funksionon njësoj."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isključi zvuk za tiho igranje. Igra radi potpuno isto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stäng av ljudet för att spela tyst. Spelet fungerar precis likadant."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zima sauti ili ucheze kimya. Mchezo utaendelea vilevile."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அமைதியாக விளையாட ஒலியை அணைக்கவும். விளையாட்டு அதேபோல இயங்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నిశ్శబ్దంగా ఆడాలంటే శబ్దాన్ని ఆఫ్ చేయి. ఆట మాత్రం అలాగే ఉంటుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดเสียงเพื่อเล่นเงียบ ๆ เกมยังเล่นเหมือนเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessiz oynamak için sesi kapat. Oyun aynı şekilde devam eder."
          }
        },
        "ug" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جىم ئويناش ئۈچۈن ئاۋازنى ئۆچۈر. ئويۇن ئوخشاشلا ئىشلەيدۇ."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимкни звук, щоб грати тихо. Гра працюватиме так само."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خاموشی سے کھیلنے کے لیے آواز بند کریں۔ کھیل بالکل ویسا ہی چلے گا۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinch o‘ynash uchun ovozni o‘chir. O‘yin xuddi shunday ishlaydi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt âm thanh để chơi yên lặng. Trò chơi vẫn hoạt động như cũ."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭声音，安静地玩。游戏玩法完全不变。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vala umsindo ukuze udlale buthule. Umdlalo usebenza ngendlela efanayo."
          }
        }
      }
    },
