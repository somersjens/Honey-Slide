        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই স্তৰত তুমি সৰ্বাধিক **%lld Honey** সংগ্ৰহ কৰিব পাৰা।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu səviyyədə **%lld Honey** qədər toplaya bilərsən."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На гэтым узроўні можна сабраць да **%lld Honey**."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
