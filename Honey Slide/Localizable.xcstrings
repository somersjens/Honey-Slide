        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നീ ഇപ്പോൾ ഒരു കളിയുടെ നടുവിലാണ്. അത് തീർക്കൂ, അല്ലെങ്കിൽ തുടങ്ങാത്തൊരു ലെവൽ തിരഞ്ഞെടുത്ത് ട്യൂട്ടോറിയൽ കളിക്കൂ."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи тоглож байна. Эхлээд дуусга, эсвэл эхлээгүй түвшин сонгоод зааврыг тоглоорой."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तू खेळाच्या मध्ये आहेस. आधी तो पूर्ण कर, किंवा सुरू न केलेला स्तर निवडून ट्युटोरियल खेळ."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu sedang bermain. Habiskan dulu, atau pilih tahap yang belum dimulakan untuk bermain tutorial."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဂိမ်းကစားနေတုန်းပါ။ အရင်ဆုံးပြီးအောင်ကစားပါ၊ ဒါမှမဟုတ် မစရသေးတဲ့ အဆင့်တစ်ခုရွေးပြီး သင်ခန်းစာကစားပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er midt i et spill. Fullfør det, eller velg et nivå du ikke har startet ennå, for å spille veiledningen."
