        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ጨዋታ መሀል ነህ። መጀመሪያ ጨርሰው፣ ወይም ያልጀመርከውን ደረጃ ምረጥና መማሪያውን ተጫወት።"
