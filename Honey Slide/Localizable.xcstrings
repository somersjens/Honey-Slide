    "levelIntro.cardsBullet.stars %lld" : {
      "comment" : "The count is always 20, 30, 40 or 50 (GameConfig level maximums), which every language treats alike, so this needs no other plural form.",
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy kan tot **%lld Honey** in hierdie vlak versamel."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በዚህ ደረጃ እስከ **%lld Honey** መሰብሰብ ትችላለህ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
