        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तिमी खेलकै बीचमा छौ। पहिले सकाऊ, वा सुरु नगरेको लेभल छान, अनि ट्युटोरियल खेल।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je zit midden in een spel. Maak het eerst af, of kies een level waar je nog niet in bezig bent, om de tutorial te spelen."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ତୁମେ ଏବେ ଏକ ଖେଳ ମଝିରେ ଅଛ। ପ୍ରଥମେ ସେଟା ସାର, କିମ୍ବା ଆରମ୍ଭ ନକରା ଲେଭେଲ୍ ବାଛି ଟ୍ୟୁଟୋରିଆଲ୍ ଖେଳ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਇੱਕ ਖੇਡ ਦੇ ਵਿਚਕਾਰ ਹੋ। ਪਹਿਲਾਂ ਇਸਨੂੰ ਪੂਰਾ ਕਰੋ ਜਾਂ ਕੋਈ ਨਾ-ਸ਼ੁਰੂ ਕੀਤਾ ਲੈਵਲ ਚੁਣੋ, ਫਿਰ ਟਿਊਟੋਰਿਅਲ ਖੇਡੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
